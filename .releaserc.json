{
  "branches": [
    "main",
    {
      "name": "staging",
      "channel": "staging",
      "prerelease": "rc"
    }
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/*.whl",
            "label": "Python wheel"
          }
        ]
      }
    ]
  ]
}
